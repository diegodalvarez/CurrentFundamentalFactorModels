get_coefficients <- function(x, model, model_name){
coef_table <- as.data.frame(summary(x[[model]])$coefficients)
coef_table$term <- rownames(coef_table)
rownames(coef_table) <- NULL
coef_table %>%
rename(
coeff = Estimate,
std_error = `Std. Error`,
t_value = `t value`,
p_value = `Pr(>|t|)`
) %>%
mutate(
field = x$field,
ticker = x$ticker,
vol_target = x$vol_target,
model = model_name,
.before = 1
)
}
