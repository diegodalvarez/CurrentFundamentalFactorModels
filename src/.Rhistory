rtn_path   <- file.path(prep_path, "VolTargetedReturns.parquet")
df_raw_rtn <- read_parquet(file = rtn_path) %>%
filter(ticker %in% sample_tickers) %>%
filter(vol_target != "lag_vol_rtn") %>%
arrange(ticker, date) %>%
