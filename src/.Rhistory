arrange(date) %>%
mutate(day = 1:n()) %>%
ungroup() %>%
filter(day <= n) %>%
inner_join(df_next_quarter_mapper, by = c("quarter")) %>%
select(-c(quarter)) %>%
rename(
rtn_date = date,
quarter  = next_quarter)
